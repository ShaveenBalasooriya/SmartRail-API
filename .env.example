# Copy this file to .env and fill in every value marked as required.
# .env is untracked; this example is the documentation for what the stack needs.

# --- API -------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080

# --- PostgreSQL (SmartRail's own database) ---------------------------------
POSTGRES_DB=smartrail
POSTGRES_USER=smartrail
# Required. Used by the api service and the postgres service.
POSTGRES_PASSWORD=

# --- Browser origins the API accepts (CORS allow-list) ---------------------
OPERATIONS_WEB_ORIGIN=http://localhost:5173
PASSENGER_WEB_ORIGIN=http://localhost:3000
STATION_DISPLAY_ORIGIN=http://localhost:8081

# --- API documentation -----------------------------------------------------
# /openapi/v1.json and /scalar. On in Development and E2E by default; set false to hide them.
DOCUMENTATION_ENABLED=true

# --- Authentik (staff identity provider) -----------------------------------
# Image and tag for the server and worker. 2026.8.3 is a published tag.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.3
# Required. Generate one with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# Authentik's own PostgreSQL database. PG_PASS is required and is used by the
# database, the server and the worker.
PG_DB=authentik
PG_USER=authentik
PG_PASS=

# Host ports for Authentik's HTTP and HTTPS listeners.
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# The URL a client reaches Authentik on. It is the issuer the API expects on staff tokens,
# so it must match the host used when the token is requested.
AUTHENTIK_PUBLIC_URL=http://localhost:9000

# --- Seeded staff app passwords --------------------------------------------
# One app password per seeded staff user (controller.mahesh, guard.ishara,
# auditor.wasantha). These are the password half of the client_credentials token request,
# which only test automation uses; staff themselves sign in with the passwords below. Ask
# for the `openid profile` scopes on that request so the access token carries `groups`.
# The blueprint reads them, and Authentik stores only their hashes. Required.
# Generate each one with: openssl rand -base64 48 | tr -d '\n'
SMARTRAIL_CONTROLLER_APP_PASSWORD=
SMARTRAIL_GUARD_APP_PASSWORD=
SMARTRAIL_AUDITOR_APP_PASSWORD=

# --- Seeded staff sign-in passwords ----------------------------------------
# One sign-in password per seeded staff user, used for the interactive authorization code
# + PKCE sign-in from the operations web, the Guard app and the Scalar page. The staff
# client is public, so these are the only staff secrets in the local stack. The blueprint
# reads them, and Authentik stores only their hashes. Required.
# Generate each one with: openssl rand -base64 48 | tr -d '\n'
SMARTRAIL_CONTROLLER_LOGIN_PASSWORD=
SMARTRAIL_GUARD_LOGIN_PASSWORD=
SMARTRAIL_AUDITOR_LOGIN_PASSWORD=

# --- Catering provider -----------------------------------------------------
# The simulated provider's API key, format srk_<8-char prefix>_<secret>. Required by the
# api service, which stores only its hash. This example is a development placeholder: use
# a random secret anywhere real. Generate one with: openssl rand -hex 24
CATERING_PROVIDER_API_KEY=srk_dev00000_dev-example-key-not-for-deployment
